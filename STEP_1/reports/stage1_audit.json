  "audit": {
    "findings": [
      {
        "id": "A1",
        "severity": "high",
        "finding": "num_docks_available is exactly 4 in 50.8% of rows and 46 of 119 stations never report anything else; docks == 0 occurs 0 times.",
        "consequence": "A 'full station' alert written as docks == 0 would never fire. The field looks like a reporting floor, not a dock count.",
        "fix": "Define FULL as docks <= 4 AND observed occupancy >= 75%. Report the floor to the feed provider."
      },
      {
        "id": "A2",
        "severity": "high",
        "finding": "bikes + docks - capacity ranges -10..14; 94 rows have more bikes than capacity.",
        "consequence": "Capacity is soft (virtual/overflow bays). fill_ratio = bikes/capacity can exceed 1.0, so it cannot be compared across stations without a caveat.",
        "fix": "Use occupancy = bikes / (bikes + docks) and keep capacity only as a reference."
      },
      {
        "id": "A3",
        "severity": "medium",
        "finding": "1 observation time(s) appear in more than one file; the files are identical. Example: DEMO_DATA_20261013_074336.csv / DEMO_DATA_20261013_074320.csv, DEMO_DATA_20261013_074336.csv.",
        "consequence": "Keeping both doubles the fleet and the empty count at that moment and distorts any rate calculated from row counts.",
        "fix": "Deduplicate on last_reported (the observation time), not the file name."
      },
      {
        "id": "A4",
        "severity": "medium",
        "finding": "The gap between collection time (file stamp) and last_reported is 5.4-10.2 min (median 8.3).",
        "consequence": "The feed is not real-time. A rider-facing 'available now' claim is already several minutes stale.",
        "fix": "Show the lag; never mix file-stamp time with last_reported in the same series."
      },
      {
        "id": "A5",
        "severity": "high",
        "finding": "4 station(s) report is_renting == False in every snapshot: King Alfred (6506), Portslade Station - North (7195), The Droveway - Waitrose (7197), London Rd / Ann Street (9648)",
        "consequence": "Those stations cannot serve a trip for the whole window; they are outages, not demand signals.",
        "fix": "Dispatch maintenance separately from rebalancing; do not count them as empty demand."
      },
      {
        "id": "A6",
        "severity": "medium",
        "finding": "28 of 119 stations never change bike count; 1 collection gap(s) longer than 30 min.",
        "consequence": "Some static stations are genuinely quiet; others may be frozen sensors. A gap makes 'what happened at 07:48' unanswerable.",
        "fix": "Split static stations into idle vs stale using last_reported; mark gaps as no-data."
      },
      {
        "id": "A7",
        "severity": "info",
        "finding": "The deduplicated panel has 7 snapshots over 2.8 h on a single day; empties moved 10 -> 14, fulls 13 -> 17.",
        "consequence": "Enough for change detection and flow; not enough for a daily profile, seasonality or a trustworthy 60-minute forecast.",
        "fix": "Keep the 5-minute collector running; gate forecasting on elapsed time and snapshots."
      }
    ],
